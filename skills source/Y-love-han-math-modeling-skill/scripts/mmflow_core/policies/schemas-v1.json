  "evidence_content_field_notes": {
    "response_matrix": {
      "rows[]": [
        "requirement_id",
        "claim_ids",
        "manuscript_target"
      ],
      "_note": "manuscript_target 是 P7 语义检查的必填字段（论文锚点，如 sec:q1）；缺失即 SEMANTIC-P7 FAIL。"
    },
    "delivery_manifest": {
      "_note": "除契约键外，P11 语义检查还要求 distribution_licenses 列表与实测必填的 smoke_command 参数列表（PACKAGE_CREATED 事件要求 smoke_test=PASS）；distribution_licenses 每项含 license/distribution_allowed/artifact_id 或 relative_path。"
    },
    "review_findings": {
      "_note": "roles[].evidence_ids 必须各指向恰好一条 VALID review_report；review_report 的 created_ledger_sequence 必须晚于最后一次 P8 GATE_RECORDED。"
    },
    "quality_assessment": {
      "_note": "dimensions[].id 必须取自 quality_dimensions 键集且 maximum 与其值精确相等；model_correctness 与 validation_counterevidence 两维 earned/max>=0.9，其余 >=0.8；total=Σearned 且 >=90。"
    },
    "production_execution": {
      "_note": "execution_ids 引用的 execution 必须由 run 命令产生（exit 0、production 类）；P9 复用本类型时不得在 P9 重复登记第二条该类型证据——跨阶段继承自 P5 即可。"
    },
    "frozen_analysis_plan": {
      "_note": "frozen_at 必须为带时区 ISO 时间；viewed_final_test 必须 false；P5 门禁用账本序号证明冻结先于全部最终执行。"
    }
  }
}
